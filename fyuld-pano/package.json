{
  "name": "@fyuld/pano",
  "version": "0.5.0",
  "description": "Panopticum. Your friendly neigbrourhood big brother for all your AI agents",
  "main": "dist/pano.js",
  "bin": {
    "pano": "dist/pano.js"
  },
  "author": "",
  "license": "GPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && npm run checks && npm run tsc",
    "prepack": "node scripts/bundle-deps.js stage",
    "postpack": "node scripts/bundle-deps.js clean",
    "pano": "ts-node src/pano.ts run",
    "pub": "npm run build && npm publish",
    "tsc": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest && npm run pano",
    "checks": "npm run test && npm run format",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "try:analyze": "ts-node src/pano.ts analyze",
    "try:assess": "ts-node src/pano.ts assess",
    "try:run": "ts-node src/pano.ts run",
    "try:taskify": "ts-node src/pano.ts taskify",
    "try:clean": "ts-node src/pano.ts clean"
  },
  "devDependencies": {
    "@fyuld/jest-cucumber-utils": "^1.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "jest": "^30.1.3",
    "jest-cucumber": "^4.5.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "ts-jest": "^29.4.2",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "dependencies": {
    "@fyuld/ldm": "^0.9.0",
    "@fyuld/mdad": "^0.9.0",
    "@fyuld/pano-bdd": "^0.1.2",
    "@fyuld/pano-dm": "^0.5.0",
    "@fyuld/pano-engine": "^0.1.9",
    "jsonpath-plus": "^10.0.0",
    "typescript": "^5.9.2"
  },
  "bundledDependencies": [
    "@fyuld/pano-bdd",
    "@fyuld/pano-dm",
    "@fyuld/pano-engine",
    "@fyuld/pano-errors"
  ]
}
