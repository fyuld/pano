{
  "name": "@fyuld/pano",
  "version": "0.1.9",
  "description": "Pan Opticum",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "",
  "license": "GPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && npm run checks && npm run tsc",
    "pub": "npm run build && npm publish",
    "update-dms": "npm install --save-dev  @fyuld/panopticum-dm",
    "tsc": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "checks": "npm run test && npm run format",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "dev:update-dms": "npm i --save @fyuld/ldm @fyuld/pano-dm"
  },
  "devDependencies": {
    "@fyuld/jest-cucumber-utils": "^1.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "jest": "^30.1.3",
    "jest-cucumber": "^4.5.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.2",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "dependencies": {
    "@fyuld/ldm": "^0.8.2",
    "@fyuld/pano-dm": "^0.3.2",
    "@fyuld/pano-errors": "^0.1.0",
    "jsonpath-plus": "^10.0.0",
    "typescript": "^5.9.2"
  }
}
