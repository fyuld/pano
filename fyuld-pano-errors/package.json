{
  "name": "@fyuld/pano-errors",
  "version": "0.1.0",
  "description": "Error throw and declaration analysis for Panopticum",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "author": "",
