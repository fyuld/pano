{
  "name": "@fyuld/pano-dm",
  "version": "0.5.0",
  "description": "Logical Datamodel for Panopticum",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "author": "",
  "license": "GPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tsc": "tsc",
    "clean": "rm -rf dist",
    "test": "jest",
    "pub": "npm run build && npm publish",
    "checks": "npm run format",
    "build": "npm run clean && npm run checks && npm run tsc",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "dev:update-dms": "npm i --save @fyuld/ldm"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.8.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@fyuld/ldm": "^0.9.0"
  }
}
